# Linux simulation image for the supervisor, arm providers, and config service.
# The build context is `platform/` so Pixi can install the workspace packages.
#
# The sim CAMERA is no longer rendered here: the retired pyrender camera2d_sim
# HAL was replaced by the external camera2d-headless service (headless-browser
# Three.js render — see deploy/Dockerfile.headless), so this image no longer
# needs OSMesa/PyOpenGL.
#
#   docker build -f deploy/Dockerfile.sim -t wf-sim .
FROM ghcr.io/prefix-dev/pixi:0.50.2-jammy

# build-essential/cmake compile source-only pypi deps (ruckig); git +
# ca-certificates + curl bootstrap a CURRENT Rust toolchain (jammy's apt cargo
# 1.75 is too old: rejects eclipse-zenoh's v4 Cargo.lock and edition2024).
# libglib2.0-0/libxrender1/libxext6/libsm6/libgl1-mesa-glx are kept as common
# shared-lib deps for the cv2/scientific stack (not pyrender-specific).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libglib2.0-0 libxrender1 libxext6 libsm6 libgl1-mesa-glx \
        build-essential cmake git ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
# Current stable Rust (cargo >= 1.85) via rustup, on PATH for the sdist builds.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --profile minimal --default-toolchain stable
ENV PATH=/root/.cargo/bin:$PATH
ENV WF_REALM=sim
# Build zenoh's git dependency via the system git (libgit2 hit SSL cert issues).
ENV CARGO_NET_GIT_FETCH_WITH_CLI=true

WORKDIR /platform

# Resolve+install the pixi env (cached unless the lock changes). --locked:
# never re-resolve in the image; the host-generated lock is authoritative.
COPY pixi.toml pixi.lock ./
COPY packages ./packages
RUN pixi install --locked

# Capture the env activation (PATH, LD_LIBRARY_PATH, conda activation vars) into
# a script the entrypoint sources, then exec the env python directly rather than
# via `pixi run` (which re-syncs the env to the lock on every invocation).
RUN pixi shell-hook -e default > /activate.sh

COPY deploy ./deploy
COPY scripts ./scripts

# Entrypoint sources the frozen activation, then execs the env python directly.
COPY deploy/sim-entrypoint.sh /sim-entrypoint.sh
RUN chmod +x /sim-entrypoint.sh
ENTRYPOINT ["/sim-entrypoint.sh"]

# The sim camera is now the external camera2d-headless service (see
# deploy/Dockerfile.headless); this image runs the other sim processes.
# Default to the supervisor; compose overrides the command per service.
CMD ["python", "-m", "wf.services.supervisor", \
     "--realm", "cell", "--cell", "deploy/cell.yaml", \
     "--runtime", "deploy/runtime/sim.yaml"]
